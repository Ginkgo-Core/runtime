{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/event.schema.json","title":"Ginkgo Core Event v1","type":"object","additionalProperties":false,"required":["event_id","event_type","event_version","occurred_at","correlation_id","payload"],"properties":{"event_id":{"type":"string","minLength":1},"event_type":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9_.-]+$"},"event_version":{"type":"string","pattern":"^v[0-9]+$"},"occurred_at":{"type":"string","format":"date-time"},"correlation_id":{"type":"string","minLength":1},"request_id":{"type":["string","null"],"minLength":1},"task_id":{"type":["string","null"],"minLength":1},"execution_id":{"type":["string","null"],"minLength":1},"actor":{"type":["object","null"],"additionalProperties":false,"properties":{"actor_id":{"type":"string","minLength":1},"actor_type":{"type":"string","minLength":1},"tenant_id":{"type":"string","minLength":1},"workspace_id":{"type":"string","minLength":1}},"required":["actor_id","actor_type"]},"payload":{"type":"object","additionalProperties":true},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}},"x-ginkgo-contract-version":"v1"}