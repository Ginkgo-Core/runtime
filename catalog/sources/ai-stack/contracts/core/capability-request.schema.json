{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/capability-request.schema.json","title":"Ginkgo CapabilityRequest v1","type":"object","additionalProperties":false,"required":["request_id","correlation_id","caller","capability","input","constraints","governance","evidence","idempotency_key"],"properties":{"request_id":{"type":"string","minLength":1},"correlation_id":{"type":"string","minLength":1},"task_id":{"type":["string","null"],"minLength":1},"execution_id":{"type":["string","null"],"minLength":1},"caller":{"type":"object","additionalProperties":false,"required":["actor_id","actor_type","tenant_id","workspace_id"],"properties":{"actor_id":{"type":"string","minLength":1},"actor_type":{"type":"string","enum":["HUMAN","WHATSAPP","N8N","HERMES","OPENCLAW","SYLVIA","API","MCP","SERVICE","OTHER"]},"tenant_id":{"type":"string","minLength":1},"workspace_id":{"type":"string","minLength":1}}},"capability":{"type":"object","additionalProperties":false,"required":["name","contract_version"],"properties":{"name":{"type":"string","minLength":3,"pattern":"^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$"},"contract_version":{"type":"string","pattern":"^v[0-9]+$"}}},"input":{"type":"object","additionalProperties":true},"constraints":{"type":"object","additionalProperties":false,"required":["fallback_policy"],"properties":{"deadline":{"type":["string","null"],"format":"date-time"},"max_cost":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["amount","currency"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"}}}]},"data_classification":{"type":"string","enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},"fallback_policy":{"type":"string","enum":["none","same_semantics_only"],"default":"none"}}},"governance":{"type":"object","additionalProperties":false,"required":["approval_context","external_gate_context"],"properties":{"approval_context":{"type":"object","additionalProperties":false,"properties":{"approval_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"policy_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},"external_gate_context":{"type":"object","additionalProperties":false,"properties":{"gate_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"required_gate_types":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}}}},"evidence":{"type":"object","additionalProperties":false,"required":["required"],"properties":{"required":{"type":"boolean"},"kinds":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},"idempotency_key":{"type":"string","minLength":1,"maxLength":255}},"description":"Universal caller-agnostic request. Callers express provider-agnostic capability intent, business input and semantic constraints only; they never select or restrict skill IDs, adapters, providers, tools, raw endpoints, credentials or secrets. Provider eligibility is derived internally by Identity / Policy and the Domain Router from capability, tenant/workspace, data classification, cost/deadline, external gates, lifecycle and other governed policy context. Domain routing resolves skill/version -> adapter -> provider.","x-ginkgo-contract-version":"v1"}