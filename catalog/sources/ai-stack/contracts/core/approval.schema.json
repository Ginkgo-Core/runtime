{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/approval.schema.json","title":"Ginkgo Approval v1","type":"object","additionalProperties":false,"required":["approval_id","state","subject","requested_at","requested_by"],"properties":{"approval_id":{"type":"string","minLength":1},"state":{"type":"string","enum":["NOT_REQUIRED","PENDING","APPROVED","REJECTED","EXPIRED"]},"subject":{"type":"object","additionalProperties":false,"required":["type","id"],"properties":{"type":{"type":"string","enum":["CAPABILITY_REQUEST","TASK","EXECUTION","POLICY_EXCEPTION","OTHER"]},"id":{"type":"string","minLength":1}}},"requested_at":{"type":"string","format":"date-time"},"requested_by":{"type":"string","minLength":1},"decided_at":{"type":["string","null"],"format":"date-time"},"decided_by":{"type":["string","null"],"minLength":1},"expires_at":{"type":["string","null"],"format":"date-time"},"reason":{"type":["string","null"],"maxLength":4096},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"transition_history":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","to","at"],"properties":{"from":{"type":"string","enum":["NOT_REQUIRED","PENDING","APPROVED","REJECTED","EXPIRED"]},"to":{"type":"string","enum":["NOT_REQUIRED","PENDING","APPROVED","REJECTED","EXPIRED"]},"at":{"type":"string","format":"date-time"},"actor_id":{"type":["string","null"]},"reason":{"type":["string","null"]}}}}},"description":"Human/business approval state machine. Approval cannot clear, replace or mutate an External Gate.","x-ginkgo-contract-version":"v1"}