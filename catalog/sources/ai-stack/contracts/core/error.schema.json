{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/error.schema.json","title":"Ginkgo Capability Error v1","type":"object","additionalProperties":false,"required":["code","message","category","retryable"],"properties":{"code":{"type":"string","minLength":1,"pattern":"^[A-Z0-9_]+$"},"message":{"type":"string","minLength":1,"maxLength":2048},"category":{"type":"string","enum":["VALIDATION","POLICY","APPROVAL","EXTERNAL_GATE","ROUTING","PROVIDER","TIMEOUT","RATE_LIMIT","CONFLICT","INTERNAL"]},"retryable":{"type":"boolean"},"details":{"type":"object","additionalProperties":true},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}},"description":"Normalized error. Secrets, credentials, raw endpoints and provider payloads MUST NOT appear in message or details.","x-ginkgo-contract-version":"v1"}