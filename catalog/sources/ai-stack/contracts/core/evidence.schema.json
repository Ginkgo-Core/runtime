{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/evidence.schema.json","title":"Ginkgo Evidence v1","type":"object","additionalProperties":false,"required":["evidence_id","record_type","kind","claim","source","collected_at","classification"],"properties":{"evidence_id":{"type":"string","minLength":1},"record_type":{"const":"evidence"},"kind":{"type":"string","enum":["TEST","EVAL","PR","COMMIT","REPORT","LOG","API_OBSERVATION","HUMAN_ATTESTATION","ARTIFACT","POLICY_CHECK","OTHER"]},"claim":{"type":"string","minLength":1,"maxLength":4096},"source":{"type":"object","additionalProperties":false,"required":["type","ref"],"properties":{"type":{"type":"string","enum":["GITHUB","RUNTIME","PROVIDER","HUMAN","FILE","DATABASE","OTHER"]},"ref":{"type":"string","minLength":1},"uri":{"type":["string","null"],"format":"uri-reference"}}},"provenance":{"type":"object","additionalProperties":true},"collected_at":{"type":"string","format":"date-time"},"classification":{"type":"string","enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},"integrity":{"type":"object","additionalProperties":false,"properties":{"sha256":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},"immutable_ref":{"type":["string","null"],"minLength":1}}},"knowledge_promotion":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"type":"string","enum":["NOT_REQUESTED","PENDING","PROMOTED","REJECTED"]},"knowledge_ref":{"type":["string","null"],"minLength":1}}}},"description":"Evidence is an execution/audit artifact and is not Knowledge. Promotion creates a separate knowledge record through knowledge.*; this evidence record remains evidence.","x-ginkgo-contract-version":"v1"}