{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Ginkgo-Core/ai-stack/contracts/core/external-gate.schema.json","title":"Ginkgo External Gate v1","type":"object","additionalProperties":false,"required":["gate_id","gate_type","state","evaluated_at","authority"],"properties":{"gate_id":{"type":"string","minLength":1},"gate_type":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9_.-]+$"},"state":{"type":"string","enum":["CLEAR","BLOCKED","UNKNOWN","EXPIRED"]},"authority":{"type":"string","minLength":1,"description":"External or deterministic authority responsible for the gate; not a human approval actor."},"evaluated_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"blocking_reason":{"type":["string","null"],"maxLength":4096},"source_ref":{"type":["string","null"],"minLength":1},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"transition_history":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","to","at"],"properties":{"from":{"type":"string","enum":["CLEAR","BLOCKED","UNKNOWN","EXPIRED"]},"to":{"type":"string","enum":["CLEAR","BLOCKED","UNKNOWN","EXPIRED"]},"at":{"type":"string","format":"date-time"},"source_ref":{"type":["string","null"]},"reason":{"type":["string","null"]}}}}},"description":"External/deterministic availability gate. It is independent of Approval and cannot be overridden by an APPROVED approval.","x-ginkgo-contract-version":"v1"}