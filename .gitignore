# Python. Replaces the stock Node .gitignore inherited from the `ginkgo-infra`
# scaffold, which the BLK-16 pre-rename audit classified as "a bare GitHub
# scaffold ... Not a template for any repo". See
# docs/adr/ADR-RT-001-implementation-stack.md.

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

.venv/
venv/
env/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

.DS_Store
*.swp
.idea/
.vscode/

# Secrets never belong in this repository at all -- the kernel takes no
# credential and no provider. These patterns are a backstop, not a permission.
.env
.env.*
*.pem
*.key

# NOT ignored, on purpose:
#   catalog/sources/              the SHA-pinned snapshot IS the input
#   catalog/sources.manifest.json the pin itself
#   catalog/catalog.snapshot.json generated, and reviewed as a diff
#   catalog/rejection-report.json generated, and reviewed as a diff
